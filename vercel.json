{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ai-news-to-email-generator\\.vercel\\.app" }],
      "destination": "https://getinformdaily.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "ai-news-to-email-generator\\.vercel\\.app" }],
      "destination": "https://getinformdaily.com/",
      "permanent": true
    },
    {
      "source": "/:page(about|contribute|development|inbox|privacy|projects|research|sources|technology|trust).html",
      "has": [{ "type": "host", "value": "ai-news-to-email-generator\\.vercel\\.app" }],
      "destination": "https://getinformdaily.com/:page.html",
      "permanent": true
    }
  ],
  "functions": {
    "app/server.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,.venv/**,.tmp/**,docker/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: https://i.ytimg.com https://media.dev.to https://media2.dev.to https://cdn.hashnode.com https://images.unsplash.com https://techcrunch.com https://theverge.com https://arstechnica.com https://cdn.arstechnica.net https://media.wired.com https://cdn.vox-cdn.com https://platform.theverge.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sources.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/contribute.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/about.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/privacy.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/trust.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/:page(development|inbox|research).html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/jobs/intelligence?slot=00", "schedule": "0 0 * * *" },
    { "path": "/api/jobs/intelligence?slot=01", "schedule": "0 1 * * *" },
    { "path": "/api/jobs/intelligence?slot=02", "schedule": "0 2 * * *" },
    { "path": "/api/jobs/intelligence?slot=03", "schedule": "0 3 * * *" },
    { "path": "/api/jobs/intelligence?slot=04", "schedule": "0 4 * * *" },
    { "path": "/api/jobs/intelligence?slot=05", "schedule": "0 5 * * *" },
