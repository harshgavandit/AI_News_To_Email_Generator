{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/server.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,.venv/**,.tmp/**,docker/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: https://i.ytimg.com https://media.dev.to https://media2.dev.to https://cdn.hashnode.com https://images.unsplash.com https://techcrunch.com https://theverge.com https://arstechnica.com https://cdn.arstechnica.net https://media.wired.com https://cdn.vox-cdn.com https://platform.theverge.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sources.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/jobs/refresh?slot=00", "schedule": "0 0 * * *" },
    { "path": "/api/jobs/refresh?slot=01", "schedule": "0 1 * * *" },
    { "path": "/api/jobs/refresh?slot=02", "schedule": "0 2 * * *" },
    { "path": "/api/jobs/refresh?slot=03", "schedule": "0 3 * * *" },
    { "path": "/api/jobs/refresh?slot=04", "schedule": "0 4 * * *" },
    { "path": "/api/jobs/refresh?slot=05", "schedule": "0 5 * * *" },
    { "path": "/api/jobs/refresh?slot=06", "schedule": "0 6 * * *" },
    { "path": "/api/jobs/refresh?slot=07", "schedule": "0 7 * * *" },
    { "path": "/api/jobs/refresh?slot=08", "schedule": "0 8 * * *" },
    { "path": "/api/jobs/refresh?slot=09", "schedule": "0 9 * * *" },
    { "path": "/api/jobs/refresh?slot=10", "schedule": "0 10 * * *" },
    { "path": "/api/jobs/refresh?slot=11", "schedule": "0 11 * * *" },
    { "path": "/api/jobs/refresh?slot=12", "schedule": "0 12 * * *" },
    { "path": "/api/jobs/refresh?slot=13", "schedule": "0 13 * * *" },
    { "path": "/api/jobs/refresh?slot=14", "schedule": "0 14 * * *" },
    { "path": "/api/jobs/refresh?slot=15", "schedule": "0 15 * * *" },
    { "path": "/api/jobs/refresh?slot=16", "schedule": "0 16 * * *" },
    { "path": "/api/jobs/refresh?slot=17", "schedule": "0 17 * * *" },
    { "path": "/api/jobs/refresh?slot=18", "schedule": "0 18 * * *" },
    { "path": "/api/jobs/refresh?slot=19", "schedule": "0 19 * * *" },
    { "path": "/api/jobs/refresh?slot=20", "schedule": "0 20 * * *" },
    { "path": "/api/jobs/refresh?slot=21", "schedule": "0 21 * * *" },
    { "path": "/api/jobs/refresh?slot=22", "schedule": "0 22 * * *" },
    { "path": "/api/jobs/refresh?slot=23", "schedule": "0 23 * * *" }
  ]
}
