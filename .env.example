# AI Provider Configuration
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Research Desk. Search falls back to keywords without vectors or AI.
NEWS_AI_RESEARCH=1
NEWS_AI_VECTORS=0
# NEWS_AI_ANALYSIS_MODEL=
# NEWS_AI_ANSWERS_DAILY=180
# NEWS_AI_QUERIES_DAILY=1000
# NEWS_AI_INDEX_BATCHES_DAILY=288
# On the existing always-on feed/mail worker:
# NEWS_AI_WORKER=1

# Public Web Application Origin
PUBLIC_ORIGIN=https://getinformdaily.com

# Public One-Click Email Delivery (1 = enabled, 0 = disabled)
PUBLIC_EMAIL_ENABLED=0
# MAIL_SESSION_SECRET=
MAIL_PILOT_MODE=0

# Transactional Email Providers (Choose one or use Gmail fallback)
# Option A: Resend API (Recommended for production)
# RESEND_API_KEY=re_123456789
# RESEND_WEBHOOK_SECRET=whsec_...
# After verifying provider capacity and MAIL_FROM, configure explicit daily budgets.
# MAIL_OUTBOUND_DAILY_LIMIT=60
# MAIL_DIGEST_DAILY_LIMIT=45
# MAIL_VERIFICATION_DAILY_LIMIT=20

# Option B: Postmark API
# POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Option C: Custom SMTP Server
# SMTP_URL=smtp://username:password@smtp.mailgun.org:587
# SMTP_HOST=smtp.example.com
# SMTP_USER=brief@example.com
# SMTP_PASS=
# SMTP_PORT=587

# Option D: Gmail SMTP Fallback
# MY_EMAIL=
# APP_PASSWORD=

# Sender Address (Optional display name and address for transactional emails)
# MAIL_FROM="Informa AI <brief@yourdomain.com>"

# Cloudflare Turnstile Bot Prevention (Required for public email verification)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Extra hostnames allowed by the existing Turnstile widget, in addition to PUBLIC_ORIGIN.
# TURNSTILE_ALLOWED_HOSTNAMES=ai-news-to-email-generator.vercel.app

# Database Storage (Pooled PostgreSQL in production, SQLite in local dev)
# NEWS_DATABASE_URL=sqlite:///./informa.db
# NEWS_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Administration & Scheduled Refresh
# ADMIN_TOKEN=
# CRON_SECRET=
# FEED_REFRESH_SECRET=match-the-encrypted-github-actions-secret
# Vercel Schedules runs publisher sweeps at 08:00 and 20:00 IST using CRON_SECRET.

# Optional shared cache. PostgreSQL still enforces delivery and API quotas.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
